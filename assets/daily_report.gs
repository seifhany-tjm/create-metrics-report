const REPORT_NAME = 'Bot processing report';
const REPORT_TIMEZONE = 'UTC'; // Set to the user's agreed IANA timezone.
const DELIVERY_HOUR = 9; // Set to the agreed local hour before installing a trigger.
const DELIVERY_MINUTE = 0;
// Insert a verified query pipeline after inspecting this bot's schema; see references/axiom-kpis.md.
const METRICS_APL = '';
const AXIOM_QUERY_URL = 'https://api.axiom.co/v1/datasets/_apl?format=tabular';

// Capture one instant so every metric uses the same latest 24 hours.
function sendLast24HoursReport() {
  const window = reportingWindow_();
  const config = configuration_();
  const email = reportForWindow_(window, config);
  MailApp.sendEmail({to: config.recipients, name: 'TJM Labs',
    subject: email.subject, body: email.text, htmlBody: email.html,
    inlineImages: {tjmLogo: Utilities.newBlob(Utilities.base64Decode(TJM_LOGO_BASE64), 'image/png', 'tjm-logo.png')}});
}

// Queries Axiom without sending email or installing a trigger.
function previewLast24HoursReport() {
  const email = reportForWindow_(reportingWindow_());
  console.log(email.text);
  return email;
}

// Run once in a dedicated report project, after a successful preview.
function installDailyTrigger() {
  const config = configuration_();
  reportQueries_(config);
  ScriptApp.getProjectTriggers()
    .filter(trigger => trigger.getHandlerFunction() === 'sendLast24HoursReport')
    .forEach(trigger => ScriptApp.deleteTrigger(trigger));
  ScriptApp.newTrigger('sendLast24HoursReport').timeBased()
  .atHour(DELIVERY_HOUR).nearMinute(DELIVERY_MINUTE).everyDays(1).inTimezone(REPORT_TIMEZONE).create();
}

function configuration_() {
  const properties = PropertiesService.getScriptProperties();
  const token = properties.getProperty('AXIOM_TOKEN');
  const orgId = properties.getProperty('AXIOM_ORG_ID');
  const dataset = properties.getProperty('AXIOM_DATASET');
  if (!dataset) throw new Error('Set AXIOM_DATASET in Script Properties.');
  const recipients = (properties.getProperty('RECIPIENT_EMAILS') || '')
    .split(/[;,\s]+/).filter(Boolean);
  if (!token || !orgId) throw new Error('Set AXIOM_TOKEN and AXIOM_ORG_ID in Script Properties.');
  if (!recipients.length || recipients.some(email => !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))) {
    throw new Error('Set valid RECIPIENT_EMAILS in Script Properties.');
  }
  return {token, orgId, dataset, recipients: recipients.join(',')};
}

function reportQueries_(config) {
  if (!METRICS_APL.trim()) throw new Error('Configure and validate METRICS_APL before running this report.');
  return `[${JSON.stringify(config.dataset)}]\n${METRICS_APL}`;
}

function reportForWindow_(window, config) {
  config = config || configuration_();
  const row = runAxiomQuery_(reportQueries_(config), window, config);
  if (count_(row, 'missing_ids')) {
    throw new Error('Completion events are missing identifiers; report was not sent.');
  }
  return buildEmail_(window, reportMetrics_(row));
}

// Suggested KPIs only. Adapt this mapping and the APL together to the user's choices.
function reportMetrics_(row) {
  const scripts = count_(row, 'scripts');
  const skipped = count_(row, 'skipped');
  const total = scripts + skipped;
  const average = row.average_s;
  if (average !== null && (typeof average !== 'number' || !Number.isFinite(average) || average < 0)) {
    throw new Error('Invalid average duration returned by Axiom.');
  }
  return [
    {label: 'Scripts processed', value: scripts},
    {label: 'Success rate', value: total ? `${(scripts / total * 100).toFixed(1)}%` : 'N/A'},
    {label: 'Total scripts', value: total},
    {label: 'Average time per script', value: average === null ? 'N/A' : `${average.toFixed(1)}s`},
    {label: 'Skipped scripts', value: skipped},
  ];
}

function runAxiomQuery_(apl, window, config) {
  const response = UrlFetchApp.fetch(AXIOM_QUERY_URL, {
    method: 'post', contentType: 'application/json',
    headers: {Authorization: `Bearer ${config.token}`, 'X-Axiom-Org-Id': config.orgId},
    payload: JSON.stringify({apl, startTime: window.start.toISOString(), endTime: window.end.toISOString()}),
    muteHttpExceptions: true,
  });
  const status = response.getResponseCode();
  if (status < 200 || status >= 300) throw new Error(`Axiom query failed (HTTP ${status}); report was not sent.`);
  return readAxiomRow_(JSON.parse(response.getContentText()));
}

function readAxiomRow_(result) {
  if (result.status?.isPartial || result.status?.isEstimate || result.status?.messages?.length) {
    throw new Error('Axiom returned an incomplete result or diagnostic; report was not sent.');
  }
  const table = result.tables?.[0];
  if (!table?.fields?.length || !table.columns || table.columns.length !== table.fields.length ||
      table.columns.some(column => !Array.isArray(column) || column.length !== 1)) {
    throw new Error('Expected one aggregate row from Axiom.');
  }
  return Object.fromEntries(table.fields.map((field, index) => [field.name, table.columns[index][0]]));
}

function count_(row, key) {
  const value = row[key];
  if (!Number.isSafeInteger(value) || value < 0) throw new Error(`Invalid Axiom count: ${key}`);
  return value;
}

// Exactly 86,400,000 milliseconds, even across daylight-saving changes.
function reportingWindow_(now = new Date()) {
  const end = new Date(now.getTime());
  if (!Number.isFinite(end.getTime())) throw new Error('Invalid report end time.');
  return {start: new Date(end.getTime() - 24 * 60 * 60 * 1000), end};
}

function buildEmail_(window, metrics) {
  if (!Array.isArray(metrics) || !metrics.length) throw new Error('Choose at least one KPI.');
  const format = date => Utilities.formatDate(date, REPORT_TIMEZONE, 'yyyy-MM-dd HH:mm:ss z');
  const period = `${format(window.start)} to ${format(window.end)}`;
  const subject = `${REPORT_NAME} | Last 24 hours | ${format(window.end)}`;
  const text = `${REPORT_NAME} — Last 24 hours\n${period}\n\n${metrics.map(metric => `${metric.label}: ${metric.value}`).join('\n')}`;
  let cards = '';
  for (let index = 0; index < metrics.length; index += 2) {
    cards += '<tr>' + metrics.slice(index, index + 2).map((metric, offset) => {
      const position = index + offset;
      if (position === 0) return metricCard_(metric.label, metric.value, '#5C288F', '#ffffff', '#E9DFFC', true);
      if (position === 1) return metricCard_(metric.label, metric.value, '#E9DFFC', '#5C288F', '#5C288F', true);
      return metricCard_(metric.label, metric.value);
    }).join('') + (index + 1 === metrics.length ? '<td width="50%"></td>' : '') + '</tr>';
  }
  const html = `<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>${escapeHtml_(subject)}</title>
  <style>@media only screen and (max-width:480px){.report-padding{padding-left:20px!important;padding-right:20px!important}.metric-value{font-size:32px!important}.metric-padding{padding:20px 16px!important}}</style>
</head>
<body style="margin:0;padding:32px 12px;background:#F4F4F5;font-family:Inter,Arial,Helvetica,sans-serif;color:#2E2E2E">
  <table role="presentation" cellspacing="0" cellpadding="0" align="center" style="width:100%;max-width:640px;margin:0 auto;background:#ffffff;border:1px solid #D9D4CC;border-radius:18px;overflow:hidden">
    <tr><td height="5" bgcolor="#5C288F" style="height:5px;background:#5C288F;border-radius:18px 18px 0 0;font-size:0;line-height:0">&nbsp;</td></tr>
    <tr><td class="report-padding" style="padding:32px 36px 0">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr>
        <td><img src="cid:tjmLogo" alt="TJM Labs" width="146" height="44" style="display:block;width:146px;height:44px;border:0"></td>
        <td align="right" style="font-size:10px;line-height:16px;letter-spacing:1.5px;color:#5C288F">OPERATIONS REPORT</td>
      </tr></table>
      <p style="margin:34px 0 10px;font-size:10px;font-weight:700;letter-spacing:2px;color:#5C288F">${escapeHtml_(REPORT_NAME)} &nbsp; / &nbsp; LAST 24 HOURS</p>
      <h1 style="margin:0;font-family:'DM Serif Display',Georgia,'Times New Roman',serif;font-size:36px;line-height:1.2;letter-spacing:-0.5px;font-weight:400;color:#2E2E2E">Processing summary</h1>
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-top:22px;border-top:1px solid #D9D4CC">
        <tr><td style="padding:16px 0 4px;font-size:11px;color:#626262;width:48px">From</td><td style="padding:16px 0 4px;font-size:12px;color:#2E2E2E">${escapeHtml_(format(window.start))}</td></tr>
        <tr><td style="padding:0 0 22px;font-size:11px;color:#626262">To</td><td style="padding:0 0 22px;font-size:12px;color:#2E2E2E">${escapeHtml_(format(window.end))}</td></tr>
      </table>
    </td></tr>
    <tr><td class="report-padding" style="padding:0 30px 30px">
      <table role="presentation" cellspacing="0" cellpadding="0" style="width:100%;table-layout:fixed">
        ${cards}
      </table>
    </td></tr>
  </table>
</body>
</html>`;
  return {subject, text, html};
}

function escapeHtml_(value) {
  return String(value).replace(/[&<>"']/g, character => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  })[character]);
}

function metricCard_(label, value, background = '#F4F4F5', color = '#2E2E2E', labelColor = '#626262', featured = false) {
  return `<td width="50%" valign="top" style="padding:6px">
    <table role="presentation" cellspacing="0" cellpadding="0" width="100%" bgcolor="${background}" style="background:${background};border-radius:12px">
      <tr><td class="metric-padding" style="padding:24px">
        <div style="font-size:12px;line-height:18px;color:${labelColor}">${escapeHtml_(label)}</div>
        <div class="metric-value" style="margin-top:12px;font-size:${featured ? 42 : 30}px;line-height:1.2;font-weight:600;letter-spacing:-1px;color:${color}">${escapeHtml_(value)}</div>
      </td></tr>
    </table>
  </td>`;
}

